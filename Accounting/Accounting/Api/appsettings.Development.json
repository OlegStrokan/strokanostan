{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5441;Database=accounting_db;Username=postgres;Password=postgres"
  },
  "InternalServices": {
    "AccountingApiKey": "accounting_dev_key"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9093",
    "MoneyEventsTopic": "payment.money-events"
  },
  "LedgerReconciliation": {
    "Enabled": true,
    "IntervalMinutes": 1,
    "StartupDelaySeconds": 10,
    "MaxAcceptableLag": 100
  },
  "Reporting": {
    "Enabled": true,
    "ReportingCurrency": "USD",
    "IntervalMinutes": 1,
    "StartupDelaySeconds": 5,
    "SeedRates": [
      { "BaseCurrency": "EUR", "QuoteCurrency": "USD", "Rate": 1.09 }
    ]
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
