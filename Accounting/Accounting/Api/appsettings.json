{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=accounting_db;Username=postgres;Password=postgres"
  },
  "InternalServices": {
    "AccountingApiKey": ""
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "MoneyEventsTopic": "payment.money-events"
  },
  "MoneyEventConsumer": {
    "Enabled": true,
    "ConsumerGroupId": "accounting-service-money-events",
    "MaxOffsetRetries": 5,
    "RetryDelaySeconds": 5
  },
  "LedgerReconciliation": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "StartupDelaySeconds": 60,
    "MaxFindings": 20,
    "MaxAcceptableLag": 1000
  },
  "Reporting": {
    "Enabled": true,
    "ReportingCurrency": "USD",
    "IntervalMinutes": 5,
    "StartupDelaySeconds": 30,
    "BatchSize": 200,
    "SeedRates": []
  },
  "IncidentReporter": {
    "Telegram": {
      "Enabled": false,
      "BotToken": "",
      "ChatId": "",
      "TimeoutSeconds": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
